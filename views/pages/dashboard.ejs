<!DOCTYPE html>
<html lang="en">


<head>

  <%- include("../components/meta",{

      title : "User Dashboard | PdfVersatile - All in One PDF Tool",
      description : "Best tool for pdf operations like converting image to PDF, PDF spliting, Merge PDf, Edit PDF Pages...",
      keywords : "Image to PDF, Merge PDF, split PDF, Edit PDF pages, extract Pages, compress PDF, convert PDF, Word to PDF, JPG to PDF, Protect PDF",
      og_url : "/user/dashboard",
      robots : "noindex,nofollow"

  }) %>

  <meta property="og:image" content="https://pdfversatile.com/images/image-og.webp" />
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  
  <%- include("../components/metaCommanCSS") %>

  <%- include("../components/metaGA") %>

</head>




<body>
  
  <%- include("../components/header") %>
  
    <div class="bg-gray-50 py-4">
      <div class="max-w-7xl mx-auto p-4 ">
        <h1 class="text-3xl font-semibold text-gray-900 mb-8 flex items-center gap-3 break-all">

          Hi, <%= name %>
        </h1>

        <!-- Grid Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

          <!-- 1. User Profile -->
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
            <h2 class="text-xl font-semibold mb-6 flex items-center gap-2 text-primary">

              Profile
            </h2>

            <div class="space-y-6">
              <!-- Greeting -->
              <div>
                <p class="text-2xl md:text-3xl font-semibold text-gray-900 break-all">
                  <%= name %>
                </p>
                <p class="text-gray-600 mt-1">
                  <%= email %>
                </p>
              </div>

              <!-- Details -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm pt-4 border-t border-gray-100">
                <div>
                  <p class="text-gray-500">Email</p>
                  <p class="font-medium text-gray-800">
                    <%= email %>
                  </p>
                </div>
                <div>
                  <p class="text-gray-500">Account Created</p>
                  <p class="font-medium text-gray-800">
                    <%= creationDate %>
                  </p>
                </div>
                <div>
                  <p class="text-gray-500">Subscription</p>
                  <p class="font-medium text-amber-600">
                    <%= subscription %>
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- 2. Reset Password -->
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
            <h2 class="text-xl font-semibold mb-6 flex items-center gap-2 text-primary">

              Reset Password
            </h2>

            <form id="resetPasswordForm" class="space-y-6">

              <!-- New Password -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">New Password</label>
                <input type="password" id="newPassword" minlength="6" required
                  class="input-focus w-full px-5 py-3.5 border border-gray-300 rounded-2xl focus:outline-none text-gray-900 placeholder-gray-400"
                  placeholder="Enter new password" />
              </div>

              <!-- Confirm Password -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Confirm New Password</label>
                <input type="password" id="confirmPassword" minlength="6" required
                  class="input-focus w-full px-5 py-3.5 border border-gray-300 rounded-2xl focus:outline-none text-gray-900 placeholder-gray-400"
                  placeholder="Confirm new password" />


                <p id="passwordError" class="text-red-600 text-sm mt-2 hidden">
                  Passwords do not match
                </p>

                <p id="passwordSuccess" class="text-green-600 text-sm mt-2 hidden">
                  Passwords changed successfully
                </p>

                <p id="somethingWrong" class="text-red-600 text-sm mt-2 hidden">
                  Something went wrong
                </p>


              </div>


              <!-- Reset Button -->
              <button type="submit"
                class="primary w-fit p-4 bg-primary rounded-2xl text-white font-semibold text-lg hover:bg-secondary hover:shadow-xl transition-all active:scale-[0.98]">
                Reset Password
              </button>

            </form>
          </div>

          <!-- 3. History -->
          <div class="lg:col-span-2 bg-white rounded-2xl p-4 md:p-6 shadow-sm border border-gray-200">
            <h2 class="text-xl font-semibold mb-6 flex items-center gap-2 text-primary">
              <i class="fas fa-history"></i>
              History
            </h2>

            <div class="overflow-x-auto">

              <% if (!pdfData || pdfData.length===0) { %>
                <p class="text-gray-500">No data available</p>
                <% } else { %>

                  <table class="w-full text-sm">
                    <thead>
                      <tr class="border-b border-gray-200">
                        <th class="text-left py-4 px-4 font-medium text-gray-600">No.</th>
                        <th class="text-left py-4 px-4 font-medium text-gray-600">Created On</th>
                        <th class="text-left py-4 px-4 font-medium text-gray-600">Action</th>
                      </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-100">

                      <% pdfData.forEach((pdf, index)=> { %>
                        <tr class="hover:bg-gray-50 transition-colors">

                          <!-- Index -->
                          <td class="py-4 px-4 font-medium text-gray-700">
                            <%= index + 1 %>
                          </td>

                          <!-- Date -->
                          <td class="py-4 px-4 text-gray-600">
                            <%= new Date(pdf.date).toLocaleString("en-IN", { day: "2-digit" , month: "long" ,
                              year: "numeric" , hour: "2-digit" , minute: "2-digit" }) %>
                          </td>

                          <!-- Action -->
                          <td class="py-4 px-4">
                            <a href="<%= pdf.url %>" download
                              class="flex items-center gap-2 text-primary hover:text-primary font-medium transition-colors">

                              <i class="fas fa-download"></i>
                              <span>Download</span>
                            </a>
                          </td>

                        </tr>
                        <% }) %>

                    </tbody>
                  </table>
                  <% } %>

            </div>
          </div>

        </div>
      </div>
    </div>

    <%- include("../components/toolsList") %>


      <div class="bg-gray-50 mb-4">
        <div class="max-w-7xl mx-auto p-4 ">

          <p id="accountDeletionError" class="text-red-600 text-sm mb-3 hidden">
            Something went wrong
          </p>

          <button
            class="delete-account-btn primary w-fit p-4 bg-red-600 rounded-2xl text-white font-semibold text-lg hover:bg-red-500 hover:shadow-xl transition-all active:scale-[0.98]">
            Delete Account
          </button>

        </div>

      </div>

      <%- include("../components/footer") %>

      <script src="/js/dorpwastrsee.js"></script>

  </body>


</html>