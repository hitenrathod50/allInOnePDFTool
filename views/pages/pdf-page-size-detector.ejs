<!DOCTYPE html>
<html lang="en">


<head>

    <%- include("../components/meta",{ title : "PDF Page Size Detector" , description
        : "Check PDF's each page size in milimeter unit." , keywords : "pdf page size detector, pdf page size detector"
        , og_url : "/pdf-page-size-detector" , robots : "index,follow" }) %>


        <meta property="og:image" content="https://pdfversatile.com/images/image-og.webp" />

        <link rel="canonical" href="https://pdfversatile.com/pdf-page-size-detector" />

        <%- include("../components/metaCommanCSS") %>

            <%- include("../components/metaGA") %>

</head>


<body>

    <%- include("../components/header") %>

        <div class="mx-auto">


            <div class="flex justify-center">

                <div class="bg-white rounded-lg shadow-lg p-6 sm:p-10 m-4 sm:mb-0 max-w-2xl md:mx-auto text-center">
                    <h1 class="text-2xl sm:text-3xl font-semibold text-primary mb-4">PDF Page Size Detector</h1>

                    <h2 class="text-gray-600 sm:text-lg tracking-wide mb-4">
                        PDF page size detector. Identify all page's dimension of PDF file.
                    </h2>

                    <div id="dropZone"
                        class="border-2 border-dashed border-gray-400 hover:border-gray-500 p-8 sm:p-10 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors duration-200">
                        <input type="file" id="pdfInput" accept="application/pdf" class="hidden"
                            onchange="handleFileSelect(event)">
                        <button id="select-pdf-btn"
                            class="bg-primary text-white sm:text-xl px-6 py-3 rounded-lg hover:bg-secondary transition  mb-4">
                            Select PDF
                        </button>
                        <p class="text-gray-600 text-sm">Drag and drop PDF here or click to select
                        </p>
                    </div>
                </div>


            </div>


            <div id="result-container" class="hidden">

                <div id="summary-div">



                </div>

                <div class="max-w-7xl mx-auto px-4 pt-4 sm:pt-10">

                    <div class="overflow-x-auto no-scrollbar">
                        <div class="min-w-[500px] bg-white rounded-lg shadow-lg overflow-hidden border border-zinc-100">

                            <!-- Table Header -->
                            <div class="grid grid-cols-10 bg-purple-50 px-8 py-5 border-b border-purple-100">
                                <div class="col-span-2 text-gray-800 font-semibold text-sm tracking-widest uppercase">
                                    Page </div>
                                <div class="col-span-2 text-gray-800 font-semibold text-sm tracking-widest uppercase">
                                    Width <span class="text-sm text-zinc-400 lowercase">(mm)</span></div>
                                <div class="col-span-2 text-gray-800 font-semibold text-sm tracking-widest uppercase">
                                    Height <span class="text-sm text-zinc-400 lowercase">(mm)</span></div>
                                <div class="col-span-2 text-gray-800 font-semibold text-sm tracking-widest uppercase">
                                    Size</div>
                                <div class="col-span-2 text-gray-800 font-semibold text-sm tracking-widest uppercase">
                                    Orientation</div>
                            </div>

                            <!-- Table Body -->
                            <div id="table-body" class="divide-y divide-zinc-100"></div>

                        </div>
                    </div>

                    <div class="flex md:justify-end mt-5 md:mt-10">
                        <button
                            class="reset-button bg-slate-900 text-fluid-sm text-white hover:bg-slate-800 px-5 py-2 rounded-full transition mb-4">
                            Reset
                        </button>
                    </div>

                </div>

            </div>





            <p class="text-2xl sm:text-3xl font-semibold text-center text-gray-800 mt-5 md:mt-10">
                Related PDF Tools
            </p>


            <%- include("../components/toolsListIcons", removeCards=["/merge-pdf", "/imagetopdf" , "/edit-pdf-pages"
                , "/word-to-pdf" , "/excel-to-pdf" , "/powerpoint-to-pdf" , "/odt-to-pdf" , "/html-to-pdf" ]) %>





        </div>

        <%- include("../components/footer") %>

            <script>
                const dropZone = document.getElementById('dropZone');

                dropZone.addEventListener('dragover', (event) => {
                    event.preventDefault();
                    console.log("dragover")
                    dropZone.classList.add('bg-gray-100');
                });

                dropZone.addEventListener('dragenter', (event) => {
                    event.preventDefault();
                    console.log("dragenter")
                    dropZone.classList.remove('border-gray-400')
                    dropZone.classList.add('bg-gray-100', 'border-primary');
                });

                dropZone.addEventListener('dragleave', (event) => {
                    event.preventDefault();
                    console.log("dragleave")
                    dropZone.classList.remove('bg-gray-100', 'border-primary');
                    dropZone.classList.add('border-gray-400')
                });

                dropZone.addEventListener('drop', (event) => {
                    event.preventDefault();
                    console.log("drop")
                    dropZone.classList.remove('bg-gray-100', 'border-primary');
                    dropZone.classList.add('border-gray-400')
                    handleDrop(event);

                });

                dropZone.addEventListener('click', () => {
                    document.getElementById('pdfInput').click();
                });

                function handleDrop(event) {
                    const files = event.dataTransfer.files;

                    if (files.length) {
                        document.getElementById('pdfInput').files = files;
                        handleFileSelect({ target: { files } });
                    }
                }

                function handleFileSelect(event) {
                    const files = event.target.files;

                    // Add your file handling logic here
                    console.log('Selected files:', files);
                }
            </script>

            <script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@latest/build/pdf.min.js"></script>

            <script src="/js/pdf-page-size-detector.js"></script>

</body>

</html>