<!DOCTYPE html>
<html lang="en">


<head>

    <%- include("../components/meta",{ title : "PDF Word Counter" , description
        : "pdf word counter tool which counter the number of words, characters, sentences in pdf file. PdfVersatile is the best online tools for all pdf operations like image to pdf, merge pdf, split pdf, compress pdf, word to pdf, extract pdf pages and many more!" , keywords
        : "pdf word counter, pdf character counter" , og_url : "/pdf-word-counter" , robots : "index,follow" }) %>


        <meta property="og:image" content="https://pdfversatile.com/images/image-og.webp" />

        <link rel="canonical" href="https://pdfversatile.com/pdf-word-counter" />

        <%- include("../components/metaCommanCSS") %>

            <%- include("../components/metaGA") %>

</head>


<body>

    <%- include("../components/header") %>

        <div class="mx-auto">


            <div class="flex justify-center">

                <div class="bg-white rounded-lg shadow-lg p-6 sm:p-10 m-4 sm:mb-0 w-full max-w-2xl md:mx-auto text-center">
                    <h1 class="text-2xl sm:text-3xl font-semibold text-primary mb-4">PDF Word Counter</h1>

                    <h2 class="text-gray-600 sm:text-lg tracking-wide mb-4">
                        Count the words from searchable PDF file. Count total characters and sentences in PDF.
                    </h2>

                    <div id="dropZone"
                        class="border-2 border-dashed border-gray-400 hover:border-gray-500 p-8 sm:p-10 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors duration-200">
                        <input type="file" id="pdfInput" accept="application/pdf" class="hidden"
                            onchange="handleFileSelect(event)">
                        <button id="select-pdf-btn"
                            class="bg-primary text-white sm:text-xl px-6 py-3 rounded-lg hover:bg-secondary transition  mb-4">
                            Select PDF
                        </button>
                        <p class="text-gray-600 text-sm">Drag and drop PDF here or click to select
                        </p>
                    </div>
                </div>


            </div>


            <div id="result-container">

            </div>





            <p class="text-2xl sm:text-3xl font-semibold text-center text-gray-800 mt-5 md:mt-10">
                Related PDF Tools
            </p>


            <%- include("../components/toolsListIcons", removeCards=["/merge-pdf", "/imagetopdf" , "/edit-pdf-pages"
                , "/word-to-pdf" , "/excel-to-pdf" , "/powerpoint-to-pdf" , "/odt-to-pdf" , "/html-to-pdf" ]) %>





        </div>

        <%- include("../components/footer") %>

            <script>
                const dropZone = document.getElementById('dropZone');

                dropZone.addEventListener('dragover', (event) => {
                    event.preventDefault();
                    console.log("dragover")
                    dropZone.classList.add('bg-gray-100');
                });

                dropZone.addEventListener('dragenter', (event) => {
                    event.preventDefault();
                    console.log("dragenter")
                    dropZone.classList.remove('border-gray-400')
                    dropZone.classList.add('bg-gray-100', 'border-primary');
                });

                dropZone.addEventListener('dragleave', (event) => {
                    event.preventDefault();
                    console.log("dragleave")
                    dropZone.classList.remove('bg-gray-100', 'border-primary');
                    dropZone.classList.add('border-gray-400')
                });

                dropZone.addEventListener('drop', (event) => {
                    event.preventDefault();
                    console.log("drop")
                    dropZone.classList.remove('bg-gray-100', 'border-primary');
                    dropZone.classList.add('border-gray-400')
                    handleDrop(event);

                });

                dropZone.addEventListener('click', () => {
                    document.getElementById('pdfInput').click();
                });

                function handleDrop(event) {
                    const files = event.dataTransfer.files;

                    if (files.length) {
                        document.getElementById('pdfInput').files = files;
                        handleFileSelect({ target: { files } });
                    }
                }

                function handleFileSelect(event) {
                    const files = event.target.files;

                    // Add your file handling logic here
                    console.log('Selected files:', files);
                }
            </script>

            <script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@latest/build/pdf.min.js"></script>

            <script src="/js/pdf-word-counter.js"></script>

</body>

</html>