<!DOCTYPE html>
<html>

<head>
    <meta name="description"
        content="contact us - a fast, free, and all-in-one PDF tool designed to simplify PDF operations like merge, split, compress, and edit.">
    <meta name="keywords" content="Contact Us PdfVersatile, Extract PDF Pages, Word to PDF, Protect PDF, Image to PDF, Merge PDF, split PDF, Edit PDF pages, extract Pages, compress PDF, convert PDF, Word to PDF, JPG to PDF, Protect PDF"/>
    <title>Get Solution of Your All Questions regarding PdfVersatile by Submitting the Form</title>
    <!-- <link rel="stylesheet" href="/css/main.css"> -->
    <meta name="robots" content="index,follow">
</head>

<style>
    .required::after {
        content: " *";
        color: #7100ad;
        font-weight: 600;
    }
</style>

<%- include("../components/header") %>

    <body>

        <div class="bg-transparent px-4" bis_skin_checked="1">

            <div class="max-w-7xl mx-auto py-10" bis_skin_checked="1">

                <div class="grid lg:grid-cols-2 gap-8  md:gap-12 items-start">

                    <!-- Left Side: Title + Description -->
                    <div>
                        <div class="space-y-6">
                            <h1 class="text-4xl text-gray-700 md:text-5xl font-bold mb-4">Contact</h1>
                            <p class="text-lg text-gray-600 text-justify">
                                Contact us to report a problem, solve any doubts about All in One PDF Tool, or just find
                                out more.
                            </p>
                        </div>
                    </div>

                    <!-- Right Side: Contact Form -->
                    <div class="bg-white rounded-3xl shadow-xl p-6 md:p-8 md:p-10">

                        <form id="contactForm" class="space-y-8">

                            <!-- Name and Email in Row (Desktop) -->
                            <div class="grid md:grid-cols-2 gap-6">
                                <!-- Name -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5 required">Full
                                        Name</label>
                                    <input type="text" id="name" required
                                        class="input-focus w-full px-5 py-3.5 border border-gray-300 rounded-2xl focus:outline-none text-gray-900 placeholder-gray-400"
                                        placeholder="John Doe" />
                                </div>

                                <!-- Email -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5 required">Email
                                        Address</label>
                                    <input type="email" id="email" required
                                        class="input-focus w-full px-5 py-3.5 border border-gray-300 rounded-2xl focus:outline-none text-gray-900 placeholder-gray-400"
                                        placeholder="you@example.com" />
                                </div>
                            </div>

                            <!-- Subject -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5 required">Subject</label>
                                <select id="subject" required
                                    class="input-focus w-full px-5 py-3.5 border border-gray-300 rounded-2xl focus:outline-none text-gray-900 bg-white">
                                    <option value="General" selected>General Inquiry</option>
                                    <option value="Billing">Billing</option>
                                    <option value="Sales">Sales</option>
                                    <option value="Feature">Suggest a Feature</option>
                                    <option value="Problem">Report a Problem</option>
                                </select>
                            </div>

                            <!-- Message -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5 required">Message</label>
                                <textarea id="message" rows="3" required
                                    class="input-focus w-full px-5 py-3.5 border border-gray-300 rounded-2xl focus:outline-none text-gray-900 placeholder-gray-400 resize-y min-h-[100px]"
                                    placeholder="How can we help you today?"></textarea>



                            </div>

                            <!-- Terms Checkbox -->

                            <div>

                                <label class="flex items-center gap-3 cursor-pointer">
                                    <input type="checkbox" id="terms"
                                        class="w-5 h-5 rounded border-gray-300 accent-purple-600 text-purple-600 focus:ring-purple-500">
                                    <div bis_skin_checked="1">
                                        <div class="text-sm text-gray-600 text-justify" bis_skin_checked="1">I accept
                                            the
                                            <a target="_blank" href="/terms-conditions" class="text-purple-600 hover:text-purple-800 underline">Terms &
                                                Conditions</a>
                                            and
                                            <a target="_blank" href="/privacy" class="text-purple-600 hover:text-purple-800 underline">Privacy
                                                Policy</a>
                                        </div>

                                    </div>
                                </label>

                                

                                <p id="messageSent" class="text-green-600 text-sm mt-2 hidden">
                                    Message sent Successfully
                                </p>

                                <p id="somethingWrong" class="text-red-600 text-sm mt-2 hidden">
                                    Something went wrong. Please try again later
                                </p>

                            </div>




                            <!-- Send Message Button -->
                            <button type="submit" id="submitBtn"
                                class="w-fit py-4 px-6 bg-primary hover:bg-purple-600 disabled:bg-purple-400 disabled:cursor-not-allowed text-white font-semibold rounded-2xl transition-all duration-200 flex items-center justify-center gap-2 text-lg">
                                <i class="fas fa-paper-plane"></i>
                                Send Message
                            </button>

                        </form>

                    </div>
                </div>

            </div>

        </div>

        <%- include("../components/footer") %>
    </body>


    <script src="/js/contact-us.js"></script>

</html>