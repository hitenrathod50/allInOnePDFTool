            <script>

                // document.getElementById("explore-more").classList.add("hidden");

                const downloadButton = document.getElementById("downloadButton");

                const previewPDF = document.getElementById("previewPDF");

                downloadButton.textContent = "Processing...";
                const token = '<%= token %>';
                const endPoint = '<%= endPoint %>';

                if (endPoint == "pdf-image-extractor") {

                    document.getElementById("download-heading").textContent = "Download Your Images";
                    document.getElementById("download-subheading").textContent = "Your Images are ready! Hit the button below to download.";

                }

                const isZip = `<%= typeof isZip !== 'undefined' && isZip ? 'true' : 'false' %>`;

                // console.log(isZip);

                if (isZip === 'true') {
                    previewPDF.classList.add('hidden');
                }

                const link = document.createElement('a');

                async function getPDFLink() {
                    try {

                        // Fetch the PDF using the token
                        const response = await fetch(`/${endPoint}/download/file/${token}`);

                        if (!response.ok) {
                            const errorData = await response.json();
                            throw new Error(errorData.error || 'Failed to download PDF');
                        }

                        // Get the PDF as a blob
                        const pdfBlob = await response.blob();

                        // Create a temporary URL for the blob
                        const pdfUrl = window.URL.createObjectURL(pdfBlob);

                        previewPDF.addEventListener('click', (event) => {
                            window.open(pdfUrl, '_blank');
                        })

                        // Create a temporary link element to trigger the download

                        link.href = pdfUrl;
                        link.download = isZip === 'true' ? 'output.zip' : 'output.pdf';
                        document.body.appendChild(link);

                    } catch (error) {
                        console.error('Error downloading PDF:', error);
                    }
                }

                getPDFLink()
                    .then(() => {
                        downloadButton.textContent = "Download File";
                        downloadButton.addEventListener('click', async function downloadPDF() {
                            link.click();
                        })
                    })



            </script>

