<!DOCTYPE html>

<html lang="en">


<head>

  <%- include("../components/meta",{

    title : typeof title !== "undefined" ? `Download - ${title}` : "Download Processed PDF",
    description : "Download you processed file with PdfVersatile, download or preview it.",
    keywords : "Image to PDF, Merge PDF, split PDF, Edit PDF pages, extract Pages, compress PDF, convert PDF, Word to PDF, JPG to PDF, Protect PDF",
    og_url : typeof endPoint !== "undefined" ? `/${endPoint}` : "/",
    robots : "noindex,follow"

}) %>

<meta property="og:image" content="https://pdfversatile.com/images/image-og.webp" />

  <%- include("../components/metaCommanCSS") %>

  <%- include("../components/metaGA") %>

</head>


<body>

    <%- include("../components/header") %>


        <div class="flex justify-center">

            <div class="bg-white rounded-lg shadow-lg p-6 sm:p-10 m-4 sm:mb-0 max-w-2xl md:mx-auto text-center">



            <h1 id="download-heading" class="text-2xl sm:text-3xl font-semibold text-primary mb-4">Download Your PDF</h1>
            <p id="download-subheading" class="text-gray-600 mb-6 sm:text-lg tracking-wide">Your PDF is ready! Hit the button below to download.
            </p>

            <div class="flex flex-col justify-center sm:flex-row gap-4 w-full">

                <a id="downloadButton" class="cursor-pointer w-full sm:w-1/2 text-white bg-primary px-4 py-2 border border-primary 
        hover:bg-secondary transition-all duration-200 rounded-md 
        flex items-center justify-center min-h-[44px]">
                    Download
                </a>

                <a id="previewPDF" class="cursor-pointer w-full sm:w-1/2 px-4 py-2 border border-primary 
        bg-white text-primary hover:bg-primary hover:text-white 
        transition-all duration-200 rounded-md 
        flex items-center justify-center min-h-[44px]">
                    Preview
                </a>

            </div>





        </div>

        </div>

        <%- include("../components/toolsList") %>

            <%- include("../components/footer") %>



        <script>

    // document.getElementById("explore-more").classList.add("hidden");

    const downloadButton = document.getElementById("downloadButton");

    const previewPDF = document.getElementById("previewPDF");

    downloadButton.textContent = "Processing...";
    const token = '<%= token %>';
    const endPoint = '<%= endPoint %>';

    if(endPoint == "pdf-image-extractor"){

        document.getElementById("download-heading").textContent = "Download Your Images";
        document.getElementById("download-subheading").textContent = "Your Images are ready! Hit the button below to download.";

    }

    const isZip = `<%= typeof isZip !== 'undefined' && isZip ? 'true' : 'false' %>`;

    // console.log(isZip);

    if (isZip === 'true') {
        previewPDF.classList.add('hidden');
    }

    const link = document.createElement('a');

    async function getPDFLink() {
        try {

            // Fetch the PDF using the token
            const response = await fetch(`/${endPoint}/download/file/${token}`);

            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.error || 'Failed to download PDF');
            }

            // Get the PDF as a blob
            const pdfBlob = await response.blob();

            // Create a temporary URL for the blob
            const pdfUrl = window.URL.createObjectURL(pdfBlob);

            previewPDF.addEventListener('click', (event) => {
                window.open(pdfUrl, '_blank');
            })

            // Create a temporary link element to trigger the download

            link.href = pdfUrl;
            link.download = isZip === 'true' ? 'output.zip' : 'output.pdf';
            document.body.appendChild(link);

        } catch (error) {
            console.error('Error downloading PDF:', error);
        }
    }

    getPDFLink()
        .then(() => {
            downloadButton.textContent = "Download File";
            downloadButton.addEventListener('click', async function downloadPDF() {
                link.click();
            })
        })



</script>

</body>




</html>