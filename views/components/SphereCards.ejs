<!-- =========================================================
     COMPONENT JAVASCRIPT
     ========================================================= -->

<script>

    (function () {

        // =========================================================
        // ELEMENTS
        // =========================================================

        const component =
            document.querySelector(".sphere-cards-component");

        if (!component) return;


        const sphere =
            component.querySelector("#sphere");


        const scene =
            component.querySelector("#sphere-scene");


        // =========================================================
        // CARDS
        //
        // Cards are now written manually in HTML.
        //
        // JavaScript ONLY positions them.
        // =========================================================

        const cards =
            Array.from(
                sphere.querySelectorAll(".sphere-card")
            );


        // =========================================================
        // SPHERE CONFIGURATION
        // =========================================================

        const radius = 380;


        // =========================================================
        // POSITION CARDS
        // =========================================================

        cards.forEach((card, i) => {

            let row;

            let colInRow;

            let totalInRow;


            /*
             * 3 horizontal latitude bands:
             *
             * Row 1 = 7 cards
             * Row 2 = 8 cards
             * Row 3 = 5 cards
             */

            if (i < 7) {

                row = 0;

                colInRow = i;

                totalInRow = 7;

            }

            else if (i < 15) {

                row = 1;

                colInRow = i - 7;

                totalInRow = 8;

            }

            else {

                row = 2;

                colInRow = i - 15;

                totalInRow = 5;

            }


            // =====================================================
            // LATITUDE
            // =====================================================

            const lat =
                (row - 1) * 32;


            // =====================================================
            // LONGITUDE
            // =====================================================

            const lon =
                (colInRow / totalInRow) * 360;


            // =====================================================
            // DEGREES → RADIANS
            // =====================================================

            const latRad =
                lat * Math.PI / 180;


            const lonRad =
                lon * Math.PI / 180;


            // =====================================================
            // SPHERICAL → CARTESIAN
            // =====================================================

            const x =
                radius *
                Math.cos(latRad) *
                Math.sin(lonRad);


            const y =
                radius *
                Math.sin(latRad);


            const z =
                radius *
                Math.cos(latRad) *
                Math.cos(lonRad);


            // =====================================================
            // POSITION
            // =====================================================

            card.style.transform = `
                translate3d(
                    ${x}px,
                    ${y}px,
                    ${z}px
                )
                rotateY(${lon}deg)
                rotateX(${-lat}deg)
            `;

        });


        // =========================================================
        // ROTATION STATE
        // =========================================================

        let rotY = 0;

        let rotX = -8;

        let scale = 1;


        // =========================================================
        // MOUSE DRAG STATE
        // =========================================================

        let isMouseDragging = false;

        let lastMouseX = 0;

        let lastMouseY = 0;


        // =========================================================
        // TOUCH STATE
        // =========================================================

        let activeTouches = new Map();

        let pinchStartDistance = null;

        let pinchStartScale = 1;


        // =========================================================
        // APPLY TRANSFORM
        // =========================================================

        function applyTransform() {

            sphere.style.transform = `
                scale(${scale})
                rotateX(${rotX}deg)
                rotateY(${rotY}deg)
            `;

        }


        // =========================================================
        // INITIAL STATE
        // =========================================================

        applyTransform();


        // =========================================================
        // MOUSE DRAG START
        // =========================================================

        scene.addEventListener(
            "mousedown",
            (e) => {

                if (e.button !== 0) return;


                isMouseDragging = true;


                lastMouseX =
                    e.clientX;


                lastMouseY =
                    e.clientY;


                scene.classList.remove(
                    "cursor-grab"
                );


                scene.classList.add(
                    "cursor-grabbing"
                );

            }
        );


        // =========================================================
        // MOUSE DRAG MOVE
        // =========================================================

        window.addEventListener(
            "mousemove",
            (e) => {

                if (!isMouseDragging) return;


                const dx =
                    e.clientX -
                    lastMouseX;


                const dy =
                    e.clientY -
                    lastMouseY;


                rotY +=
                    dx * 0.25;


                rotX -=
                    dy * 0.2;


                rotX = Math.max(
                    -45,
                    Math.min(45, rotX)
                );


                lastMouseX =
                    e.clientX;


                lastMouseY =
                    e.clientY;


                applyTransform();

            }
        );


        // =========================================================
        // MOUSE DRAG END
        // =========================================================

        window.addEventListener(
            "mouseup",
            () => {

                if (!isMouseDragging) return;


                isMouseDragging = false;


                scene.classList.remove(
                    "cursor-grabbing"
                );


                scene.classList.add(
                    "cursor-grab"
                );

            }
        );


        // =========================================================
        // TOUCH HELPER
        // =========================================================

        function getTouchDistance() {

            const touches =
                Array.from(
                    activeTouches.values()
                );


            if (touches.length < 2) {

                return null;

            }


            const first =
                touches[0];


            const second =
                touches[1];


            const dx =
                second.clientX -
                first.clientX;


            const dy =
                second.clientY -
                first.clientY;


            return Math.sqrt(
                dx * dx +
                dy * dy
            );

        }


        // =========================================================
        // TOUCH START
        // =========================================================

        scene.addEventListener(
            "touchstart",
            (e) => {

                for (
                    const touch
                    of e.changedTouches
                ) {

                    activeTouches.set(
                        touch.identifier,
                        touch
                    );

                }


                // =================================================
                // TWO FINGER PINCH
                // =================================================

                if (
                    activeTouches.size === 2
                ) {

                    const distance =
                        getTouchDistance();


                    if (distance) {

                        pinchStartDistance =
                            distance;


                        pinchStartScale =
                            scale;

                    }


                    e.preventDefault();

                    return;

                }


                // =================================================
                // SINGLE FINGER
                // =================================================

                if (
                    activeTouches.size === 1
                ) {

                    const touch =
                        activeTouches
                            .values()
                            .next()
                            .value;


                    lastMouseX =
                        touch.clientX;


                    lastMouseY =
                        touch.clientY;

                }

            },
            {
                passive: false
            }
        );


        // =========================================================
        // TOUCH MOVE
        // =========================================================

        scene.addEventListener(
            "touchmove",
            (e) => {

                // Update touch positions

                for (
                    const touch
                    of e.changedTouches
                ) {

                    if (
                        activeTouches.has(
                            touch.identifier
                        )
                    ) {

                        activeTouches.set(
                            touch.identifier,
                            touch
                        );

                    }

                }


                // =================================================
                // TWO FINGER PINCH
                // =================================================

                if (
                    activeTouches.size >= 2
                ) {

                    const distance =
                        getTouchDistance();


                    if (
                        distance &&
                        pinchStartDistance
                    ) {

                        const ratio =
                            distance /
                            pinchStartDistance;


                        scale =
                            pinchStartScale *
                            ratio;


                        scale = Math.max(
                            0.55,
                            Math.min(1.6, scale)
                        );


                        applyTransform();

                    }


                    e.preventDefault();

                    return;

                }


                // =================================================
                // SINGLE FINGER ROTATION
                // =================================================

                if (
                    activeTouches.size === 1
                ) {

                    const touch =
                        activeTouches
                            .values()
                            .next()
                            .value;


                    const dx =
                        touch.clientX -
                        lastMouseX;


                    const dy =
                        touch.clientY -
                        lastMouseY;


                    /*
                     * Horizontal movement:
                     * rotate sphere.
                     *
                     * Vertical movement:
                     * allow page scrolling.
                     */

                    if (
                        Math.abs(dx) >
                        Math.abs(dy)
                    ) {

                        rotY +=
                            dx * 0.25;


                        rotX -=
                            dy * 0.2;


                        rotX = Math.max(
                            -45,
                            Math.min(45, rotX)
                        );


                        applyTransform();


                        e.preventDefault();

                    }


                    lastMouseX =
                        touch.clientX;


                    lastMouseY =
                        touch.clientY;

                }

            },
            {
                passive: false
            }
        );


        // =========================================================
        // TOUCH END
        // =========================================================

        scene.addEventListener(
            "touchend",
            (e) => {

                for (
                    const touch
                    of e.changedTouches
                ) {

                    activeTouches.delete(
                        touch.identifier
                    );

                }


                if (
                    activeTouches.size < 2
                ) {

                    pinchStartDistance =
                        null;

                }

            },
            {
                passive: true
            }
        );


        // =========================================================
        // TOUCH CANCEL
        // =========================================================

        scene.addEventListener(
            "touchcancel",
            (e) => {

                for (
                    const touch
                    of e.changedTouches
                ) {

                    activeTouches.delete(
                        touch.identifier
                    );

                }


                pinchStartDistance =
                    null;

            },
            {
                passive: true
            }
        );


        // =========================================================
        // MOUSE WHEEL
        // =========================================================

        scene.addEventListener(
            "wheel",
            () => {

                // Intentionally empty.

            },
            {
                passive: true
            }
        );

    })();

</script>