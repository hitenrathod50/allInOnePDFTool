<style>

    /* =========================================================
       3D SCENE
       ========================================================= */

    .sphere-scene {

        perspective: 1200px;

        perspective-origin: 50% 45%;

        touch-action: pan-y;

    }


    .sphere-cards-component .preserve-3d {

        transform-style: preserve-3d;

    }


    /* =========================================================
       VISUAL SPHERE
       ========================================================= */

    .sphere-cards-component .sphere-surface {

        transform-style: preserve-3d;

        z-index: -1;

    }


    /* =========================================================
       CARD
       ========================================================= */

    .sphere-cards-component .sphere-card {

        position: absolute;

        /*
         * Fixed square size.
         *
         * Every card is guaranteed to be 1:1.
         */
        width: 200px;

        height: 200px;

        /*
         * The coordinate represents the CENTER
         * of the card.
         */
        left: -100px;

        top: -100px;

        /*
         * Important for the 3D sphere.
         */
        transform-style: preserve-3d;

        backface-visibility: hidden;

        box-sizing: border-box;

        overflow: hidden;

        text-decoration: none;

        display: flex;

        flex-direction: column;

        align-items: flex-start;

        justify-content: flex-start;

        padding: 18px;

        border-radius: 16px;

        border: 1px solid transparent;

        background: white;

        text-align: left;

        box-shadow:
            0 4px 14px rgba(0, 0, 0, 0.08);

        transition:
            border-color 0.3s ease,
            box-shadow 0.3s ease;

    }


    /* =========================================================
       CARD HOVER
       ========================================================= */

    .sphere-cards-component .sphere-card:hover {

        z-index: 5;

        border-color: #9ca3af;

        box-shadow:
            0 8px 24px rgba(0, 0, 0, 0.14);

    }


    /* =========================================================
       CARD ICON
       ========================================================= */

    .sphere-cards-component .sphere-card-icon {

        width: 52px;

        height: 52px;

        flex-shrink: 0;

        object-fit: contain;

        margin-bottom: 10px;

    }


    /* =========================================================
       CARD TITLE
       ========================================================= */

    .sphere-cards-component .sphere-card-title {

        margin: 0 0 8px 0;

        font-size: 18px;

        line-height: 1.25;

        font-weight: 600;

        color: #1f2937;

        overflow-wrap: break-word;

    }


    /* =========================================================
