<div class="grid grid-cols-1 sm:grid-cols-4 gap-4 sm:gap-6 p-4 lg:mx-20 cst:mx-32 md:p-5">

    <!-- Card 1 -->
    <div class="bg-white rounded-xl p-5 sm:p-6 
                aspect-auto sm:aspect-[5/3] md:aspect-[5/4] flex flex-col items-center justify-start text-center">
        
        <img src="/images/tool-description.svg" alt="tool-description" loading="lazy" class="w-10 h-10 mb-3">

        
        
        <h3 class="text-xl font-semibold text-gray-900 mb-3">
            <%= tool_info["tool-description"].name %>
        </h3>
        <p class="text-gray-600">
            <%= tool_info["tool-description"].desc %>
        </p>
    </div>

    <!-- Card 2 -->
    <div class="bg-white rounded-xl p-5 sm:p-6 
                aspect-auto sm:aspect-[5/3] md:aspect-[5/4] flex flex-col items-center justify-start text-center">
        
        <img src="/images/tool-working-process.svg" alt="tool-working-process" loading="lazy" class="w-10 h-10 mb-3">

        
        
        <h3 class="text-xl font-semibold text-gray-900 mb-3">
            <%= tool_info["tool-process"].name %>
        </h3>
        <p class="text-gray-600">
            <%= tool_info["tool-process"].desc %>
        </p>
    </div>

    <!-- Card 3 -->
    <div class="bg-white rounded-xl p-5 sm:p-6 
                aspect-auto sm:aspect-[5/3] md:aspect-[5/4] flex flex-col items-center justify-start text-center">
        
        <img src="/images/tool-setting.svg" alt="tool-setting" loading="lazy" class="w-10 h-10 mb-3">

        
        
        <h3 class="text-xl font-semibold text-gray-900 mb-3">
            <%= tool_info["tool-setting"].name %>
        </h3>
        <p class="text-gray-600">
            <%= tool_info["tool-setting"].desc %>
        </p>
    </div>

    <!-- Card 4 -->
    <div class="bg-white rounded-xl p-5 sm:p-6 
                aspect-auto sm:aspect-[5/3] md:aspect-[5/4] flex flex-col items-center justify-start text-center">
        
        <img src="/images/download-pdf-preview.svg" alt="download-pdf-preview" loading="lazy" class="w-10 h-10 mb-3">

        
        
        <h3 class="text-xl font-semibold text-gray-900 mb-3">
            <%= tool_info["download-info"].name %>
        </h3>
        <p class="text-gray-600">
            <%= tool_info["download-info"].desc %>
        </p>
    </div>

</div>