<%
  const tools = [
  {
    tool_url: "/merge-pdf",
    tool_icon: "/images/merge-pdf-icon.webp",
    tool_name: "Merge Multiple PDF",
    tool_desc: "Merge multiple files in single PDF without compression & singup."
  },
  {
    tool_url: "/split-pdf",
    tool_icon: "/images/split-pdf-icon.webp",
    tool_name: "Split PDF",
    tool_desc: "Split PDF into multiple files without signup required."
  },
  {
    tool_url: "/imagetopdf",
    tool_icon: "/images/imagetopdf-icon.webp",
    tool_name: "Image to PDF",
    tool_desc: "Merge images of any type into single PDF without watermark, losing quality & signup."
  },
  {
    tool_url: "/edit-pdf-pages",
    tool_icon: "/images/edit-pdf-pages-icon.webp",
    tool_name: "Create fillable PDF",
    tool_desc: "Create fillable PDF free. Add shapes, text, images or draw, highligh on PDF page."
  },
  {
    tool_url: "/rotate-pages",
    tool_icon: "/images/rotate-pages-icon.webp",
    tool_name: "Rotate PDF pages",
    tool_desc: "Rotate PDF pages online. Select the rotation you want and get rotated PDF."
  },
  {
    tool_url: "/add-page-numbers",
    tool_icon: "/images/add-page-numbers-icon.webp",
    tool_name: "Insert page number",
    tool_desc: "Insert page number to PDF with formats like numerical, roman, full page count etc."
  },
  {
    tool_url: "/add-pages-pdf",
    tool_icon: "/images/add-pages-pdf-icon.webp",
    tool_name: "Add images to PDF",
    tool_desc: "Add images to PDF online free without images compression."
  },
  {
    tool_url: "/remove-pages",
    tool_icon: "/images/remove-pages-icon.webp",
    tool_name: "Remove pages",
    tool_desc: "Remove unwanted images/pages from PDF in few clicks."
  },
  {
    tool_url: "/add-watermark",
    tool_icon: "/images/add-watermark-icon.webp",
    tool_name: "Add Watermark",
    tool_desc: "Add text or image watermark to your PDF."
  },
  {
    tool_url: "/word-to-pdf",
    tool_icon: "/images/word-to-pdf-icon.webp",
    tool_name: "Word to PDF",
    tool_desc: "Convert word to PDF or merge word documents into single PDF."
  },
  {
    tool_url: "/excel-to-pdf",
    tool_icon: "/images/excel-to-pdf-icon.webp",
    tool_name: "EXCEL to PDF",
    tool_desc: "Convert Excel to PDF online or merge them into single PDF."
  },
  {
    tool_url: "/powerpoint-to-pdf",
    tool_icon: "/images/powerpoint-to-pdf-icon.webp",
    tool_name: "PowerPoint to PDF",
    tool_desc: "Convert PowerPoint presentations into PDF."
  },
  {
    tool_url: "/odt-to-pdf",
    tool_icon: "/images/odt-to-pdf-icon.webp",
    tool_name: "ODT to PDF",
    tool_desc: "Convert OpenDocument Text to PDF online."
  },
  {
    tool_url: "/html-to-pdf",
    tool_icon: "/images/html-to-pdf-icon.webp",
    tool_name: "HTML to PDF",
    tool_desc: "Convert website URL to PDF online free."
  },
  {
    tool_url: "/extract-pdf-pages",
    tool_icon: "/images/extract-pdf-pages-icon.webp",
    tool_name: "Extract Pages",
    tool_desc: "Extract PDF pages online in image or PDF format."
  },
  {
    tool_url: "/compress-pdf",
    tool_icon: "/images/compress-pdf-icon.webp",
    tool_name: "Compress PDF",
    tool_desc: "Compress PDF files without losing quality."
  },
  {
    tool_url: "/protect-pdf",
    tool_icon: "/images/protect-pdf-icon.webp",
    tool_name: "Protect PDF",
    tool_desc: "Secure your PDF with password protection."
  },
  {
    tool_url: "/unlock-pdf",
    tool_icon: "/images/unlock-pdf-icon.webp",
    tool_name: "Unlock PDF",
    tool_desc: "Remove password protection from PDF files."
  }
];

  // fallback if not passed
  const remove = typeof removeCards !== "undefined" ? removeCards : [];
%>


<div class="md:px-6 py-5">
<div class="tools-icon-list grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6 p-4 sm:p-5">

  <% tools.forEach(tool => { %>

    <% if (!remove.includes(tool.tool_url)) { %>

      <a href="<%= tool.tool_url %>" 
   class="bg-white shadow-md rounded-xl p-5 sm:p-6 
          aspect-auto sm:aspect-square flex flex-col items-start justify-start text-left
          border border-transparent hover:border-gray-300
          hover:shadow-lg transition duration-300">

          <img src="<%= tool.tool_icon %>" 
               alt="<%= tool.tool_name %>" 
               loading="lazy" 
               class="w-16 h-16 mb-3">

          <h3 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-3">
              <%= tool.tool_name %>
          </h3>

          <p class="text-gray-600">
              <%= tool.tool_desc %>
          </p>

      </a>

    <% } %>

  <% }) %>

</div>
</div>