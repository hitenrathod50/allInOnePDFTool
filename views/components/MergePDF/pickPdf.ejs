<div class="flex justify-center">
  <div class="bg-white rounded-lg shadow-lg p-6 sm:p-10 m-4 sm:mb-0 max-w-2xl md:mx-auto text-center">
    <h1 class="text-2xl sm:text-3xl font-semibold text-[var(--primary-color)] mb-4">Merge PDF Files</h1>

    <h2 class="text-gray-600 sm:text-lg tracking-wide mb-4">
      Combine multiple PDF files into one. Fast, secure & without quality loss.
    </h2>

    <div id="dropZone"
      class="border-2 border-dashed border-primary p-8 sm:p-10 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors duration-200">
      <input type="file" id="pdfInputFirst" accept="application/pdf" multiple class="hidden"
        onchange="handleFileSelect(event)">
      <button
        class="bg-[var(--primary-color)] text-white sm:text-xl px-6 py-3 rounded-lg hover:bg-purple-700 transition mb-4">
        Select PDFs
      </button>
      <p class="text-gray-600 text-sm">Drag and drop PDF files here or click to select</p>
    </div>
  </div>
</div>

<% const tool = {
  "tool-description": {
    name: "Drop/Select PDF Files",
    desc: "select/drop any number of PDF files to merge them into a single PDF."
  },
  "tool-process": {
    name: "Move PDF Cards",
    desc: "reorder PDF cards by dragging to change their position in the final file."
  },
  "tool-setting": {
    name: "Advance Settings",
    desc: "set page margins, orientation, and other PDF options."
  },
  "download-info": {
    name: "Single Click Conversion",
    desc: "merge PDFs in one click with fast processing."
  }
}; %>

<%- include("../toolOperations", {tool_info : tool}) %>

<div id="tool-usage" class="py-10 md:py-10 bg-white mt-5 sm:mt-0">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <p class="text-2xl sm:text-3xl font-semibold text-center text-primary mb-5">
      How to use Merge PDF Tool
    </p>

    <!-- Step 1 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10 md:mb-20">
      <div class="lg:order-1">
        <%- include("../carousel", { images: ["/images/mergepdf-laptop-1.webp", "/images/mergepdf-tablet-1.webp", "/images/mergepdf-mobile-1.webp"] }) %>
      </div>
      <div class="space-y-6 lg:order-2">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Drop or Select PDF Files</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Upload multiple PDF files by dragging & dropping or clicking the select button. No signup required.
        </p>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10 md:mb-20">
      <div class="space-y-6 order-2 lg:order-1">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Move PDF Cards</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Reorder the uploaded PDFs by dragging the cards. The final merged PDF will follow your custom order.
        </p>
      </div>
      <div class="order-1 lg:order-2">
        <%- include("../carousel", { images: ["/images/mergepdf-laptop-2.webp", "/images/mergepdf-tablet-2.webp", "/images/mergepdf-mobile-2.webp"] }) %>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10">
      <div class="lg:order-1">
        <%- include("../carousel", { images: ["/images/mergepdf-laptop-3.webp", "/images/mergepdf-tablet-3.webp", "/images/mergepdf-mobile-3.webp"] }) %>
      </div>
      <div class="space-y-6 lg:order-2">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Download Merged PDF</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Preview and download your combined PDF with a single click. Fast, secure, and high quality.
        </p>
      </div>
    </div>
  </div>
</div>

<div id="faq-section" class="bg-white sm:mt-0 mb-10">
  <div class="max-w-5xl mx-auto px-4 md:px-6">
    <p class="text-2xl sm:text-3xl font-semibold sm:text-center text-primary mb-5 sm:mb-10">
      Frequently Asked Questions
    </p>

    <div class="bg-white rounded-xl px-2 py-5 sm:p-5">
      <h3 class="text-xl sm:text-2xl font-semibold text-gray-700">
        What is a Merge PDF tool?
      </h3>
      <p class="text-gray-600 mt-3 sm:text-lg leading-relaxed">
        It allows you to combine multiple PDF files into a single PDF document quickly and easily.
      </p>
    </div>

    <div class="border-t border-gray-200 mx-0 sm:mx-10"></div>

    <div class="bg-white rounded-xl px-2 py-5 sm:p-5">
      <h3 class="text-xl sm:text-2xl font-semibold text-gray-700">
        Does the order of PDFs matter?
      </h3>
      <p class="text-gray-600 mt-3 sm:text-lg leading-relaxed">
        Yes. You can drag and drop the PDF cards to arrange them in any order you want before merging.
      </p>
    </div>
  </div>
</div>

<div class="border-t border-gray-200 mx-4 sm:mx-5"></div>

<p class="text-2xl sm:text-3xl font-semibold text-center text-gray-800 mt-10">
  Explore More Tools
</p>

<%- include("../toolsListIcons", { removeCards: ["/merge-pdf"] }) %>

<%- include("../footer") %>

<script>
  const dropZone = document.getElementById('dropZone');

  dropZone.addEventListener('dragover', (event) => {
    event.preventDefault();
    dropZone.classList.add('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('dragenter', (event) => {
    event.preventDefault();
    dropZone.classList.add('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('dragleave', (event) => {
    event.preventDefault();
    dropZone.classList.remove('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('drop', (event) => {
    event.preventDefault();
    dropZone.classList.remove('bg-purple-100', 'border-solid', 'border-black-500');
    handleDrop(event);
  });

  dropZone.addEventListener('click', () => {
    document.getElementById('pdfInputFirst').click();
  });

  function handleDrop(event) {
    const files = event.dataTransfer.files;
    if (files.length) {
      document.getElementById('pdfInputFirst').files = files;
      handleFileSelect({ target: { files } });
    }
  }

  function handleFileSelect(event) {
    const files = event.target.files;
    // Add your file handling logic here
    console.log('Selected PDF files:', files);
  }
</script>