<div class="flex justify-center">
  <div class="bg-white rounded-lg shadow-lg p-6 sm:p-10 m-4 sm:mb-0 max-w-2xl md:mx-auto text-center">
    <h1 class="text-2xl sm:text-3xl font-semibold text-[var(--primary-color)] mb-4">Add Pages to PDF</h1>

    <h2 class="text-gray-600 sm:text-lg tracking-wide mb-4">
      Add new pages (from images or other PDFs) into an existing PDF document easily.
    </h2>

    <div id="dropZone"
      class="border-2 border-dashed border-primary p-8 sm:p-10 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors duration-200">
      <input type="file" id="pdfInputFirst" accept="application/pdf" class="hidden"
        onchange="handleFileSelect(event)">
      <button
        class="bg-[var(--primary-color)] text-white sm:text-xl px-6 py-2 sm:py-3 rounded-lg hover:bg-purple-700 transition mb-4">
        Select PDF
      </button>
      <p class="text-gray-600 text-sm">Drag and drop PDF or images here or click to select</p>
    </div>
  </div>
</div>

<% const tool = {
  "tool-description": {
    name: "Drop/Select PDF File",
    desc: "select/drop PDF file to add more pages into it."
  },
  "tool-process": {
    name: "Add Pages to the PDF",
    desc: "select images or pages you want to add into the PDF."
  },
  "tool-setting": {
    name: "Advance Settings",
    desc: "set page size, page orientation and margin of pages."
  },
  "download-info": {
    name: "Single Click Conversion",
    desc: "add pages to PDF in single click within some time."
  }
}; %>

<%- include("../toolOperations", {tool_info : tool}) %>

<div id="tool-usage" class="py-10 md:py-10 bg-white mt-5 sm:mt-0">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <p class="text-2xl sm:text-3xl font-semibold text-center text-primary mb-5">
      How to use Add Pages to PDF Tool
    </p>

    <!-- Step 1 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10 md:mb-20">
      <div class="lg:order-1">
        <%- include("../carousel", { images: ["/images/addpages-laptop-1.webp", "/images/addpages-tablet-1.webp", "/images/addpages-mobile-1.webp"] }) %>
      </div>
      <div class="space-y-6 lg:order-2">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Upload Base PDF</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Drag & drop or select the main PDF file to which you want to add more pages.
        </p>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10 md:mb-20">
      <div class="space-y-6 order-2 lg:order-1">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Add New Pages</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Upload images or additional PDF pages that you want to insert into the document.
        </p>
      </div>
      <div class="order-1 lg:order-2">
        <%- include("../carousel", { images: ["/images/addpages-laptop-2.webp", "/images/addpages-tablet-2.webp", "/images/addpages-mobile-2.webp"] }) %>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10">
      <div class="lg:order-1">
        <%- include("../carousel", { images: ["/images/addpages-laptop-3.webp", "/images/addpages-tablet-3.webp", "/images/addpages-mobile-3.webp"] }) %>
      </div>
      <div class="space-y-6 lg:order-2">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Download Final PDF</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Reorder pages if needed and download the final combined PDF with added pages.
        </p>
      </div>
    </div>
  </div>
</div>

<div id="faq-section" class="bg-white sm:mt-0 mb-10">
  <div class="max-w-5xl mx-auto px-4 md:px-6">
    <p class="text-2xl sm:text-3xl font-semibold sm:text-center text-primary mb-5 sm:mb-10">
      Frequently Asked Questions
    </p>

    <div class="bg-white rounded-xl px-2 py-5 sm:p-5">
      <h3 class="text-xl sm:text-2xl font-semibold text-gray-700">
        What is Add Pages to PDF?
      </h3>
      <p class="text-gray-600 mt-3 sm:text-lg leading-relaxed">
        It allows you to insert additional pages (from images or other PDFs) into an existing PDF document.
      </p>
    </div>

    <div class="border-t border-gray-200 mx-0 sm:mx-10"></div>

    <div class="bg-white rounded-xl px-2 py-5 sm:p-5">
      <h3 class="text-xl sm:text-2xl font-semibold text-gray-700">
        Can I add both images and PDFs?
      </h3>
      <p class="text-gray-600 mt-3 sm:text-lg leading-relaxed">
        Yes. You can add images (JPG, PNG) as well as pages from other PDF files.
      </p>
    </div>
  </div>
</div>

<div class="border-t border-gray-200 mx-4 sm:mx-5"></div>

<p class="text-2xl sm:text-3xl font-semibold text-center text-gray-800 mt-10">
  Explore More Tools
</p>

<%- include("../toolsListIcons", { removeCards: ["/add-pages-pdf"] }) %>

<%- include("../footer") %>

<script>
  const dropZone = document.getElementById('dropZone');

  dropZone.addEventListener('dragover', (event) => {
    event.preventDefault();
    dropZone.classList.add('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('dragenter', (event) => {
    event.preventDefault();
    dropZone.classList.add('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('dragleave', (event) => {
    event.preventDefault();
    dropZone.classList.remove('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('drop', (event) => {
    event.preventDefault();
    dropZone.classList.remove('bg-purple-100', 'border-solid', 'border-black-500');
    handleDrop(event);
  });

  dropZone.addEventListener('click', () => {
    document.getElementById('pdfInputFirst').click();
  });

  function handleDrop(event) {
    const files = event.dataTransfer.files;
    if (files.length) {
      document.getElementById('pdfInputFirst').files = files;
      handleFileSelect({ target: { files } });
    }
  }

  function handleFileSelect(event) {
    const files = event.target.files;
    // Add your file handling logic here
    console.log('Selected files:', files);
  }
</script>