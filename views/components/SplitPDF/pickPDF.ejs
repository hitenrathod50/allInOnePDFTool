<div class="flex justify-center">
  <div class="bg-white rounded-lg shadow-lg p-6 sm:p-10 m-4 sm:mb-0 max-w-2xl md:mx-auto text-center">
    <h1 class="text-2xl sm:text-3xl font-semibold text-[var(--primary-color)] mb-4">Split PDF</h1>

    <h2 class="text-gray-600 sm:text-lg tracking-wide mb-4">
      Split PDF into multiple files. Choose custom page ranges with precision.
    </h2>

    <div id="dropZone"
      class="border-2 border-dashed border-primary p-8 sm:p-10 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors duration-200">
      <input type="file" id="pdfInput" accept="application/pdf" class="hidden"
        onchange="handleFileSelect(event)">
      <button
        class="bg-[var(--primary-color)] text-white sm:text-xl px-6 py-3 rounded-lg hover:bg-purple-700 transition mb-4">
        Select PDF
      </button>
      <p class="text-gray-600 text-sm">Drag and drop PDF here or click to select</p>
    </div>
  </div>
</div>

<% const tool = {
  "tool-description": {
    name: "Drop/Select PDF File",
    desc: "select/drop a PDF file to split it into multiple files."
  },
  "tool-process": {
    name: "Select Page Ranges",
    desc: "choose specific page ranges to split the PDF."
  },
  "tool-setting": {
    name: "Advance Settings",
    desc: "set margins, page orientation, and other options."
  },
  "download-info": {
    name: "Single Click Conversion",
    desc: "split PDF in single click with fast processing."
  }
}; %>

<%- include("../toolOperations", {tool_info : tool}) %>

<div id="tool-usage" class="py-10 md:py-10 bg-white mt-5 sm:mt-0">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
