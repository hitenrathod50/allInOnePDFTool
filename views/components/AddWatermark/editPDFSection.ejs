<script>
    const shapeBtns = document.querySelectorAll(".shapesBtn");
    const dropdown = document.getElementById("shapesDropdown");

    const elements = document.querySelectorAll('.addWatermarkEl');

    shapeBtns.forEach(btn => {
        btn.addEventListener("click", (e) => {

            const rect = btn.getBoundingClientRect();

            // console.log(rect.top +" "+ typeof(rect.top));

            if (window.innerWidth >= 1024) {
                // Desktop → dropdown right side
                dropdown.style.top = rect.top - 80 + "px";
                dropdown.style.left = rect.right + 5 + "px";
            } else {
                // Mobile / Tablet → dropdown below
                dropdown.style.top = rect.top + "px";
                dropdown.style.left = rect.left + "px";
            }

            dropdown.classList.toggle("hidden");

            e.stopPropagation();
        });
    });


    elements.forEach(el => {
        el.classList.add('hidden');
    });


</script>