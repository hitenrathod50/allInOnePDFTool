    <!-- Step 1 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10 md:mb-20">
      <div class="lg:order-1">
        <%- include("../carousel", { images: ["/images/removepages-laptop-1.webp", "/images/removepages-tablet-1.webp", "/images/removepages-mobile-1.webp"] }) %>
      </div>
      <div class="space-y-6 lg:order-2">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Upload PDF File</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Drag & drop or select the PDF from which you want to remove pages.
        </p>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10 md:mb-20">
      <div class="space-y-6 order-2 lg:order-1">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Select Pages to Remove</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Preview all pages and select the ones you want to delete. You can remove single or multiple pages.
        </p>
      </div>
      <div class="order-1 lg:order-2">
        <%- include("../carousel", { images: ["/images/removepages-laptop-2.webp", "/images/removepages-tablet-2.webp", "/images/removepages-mobile-2.webp"] }) %>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10">
      <div class="lg:order-1">
        <%- include("../carousel", { images: ["/images/removepages-laptop-3.webp", "/images/removepages-tablet-3.webp", "/images/removepages-mobile-3.webp"] }) %>
      </div>
      <div class="space-y-6 lg:order-2">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Download Clean PDF</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Preview the remaining pages and download your cleaned PDF instantly.
        </p>
      </div>
    </div>
  </div>
</div>

<div id="faq-section" class="bg-white sm:mt-0 mb-10">
  <div class="max-w-5xl mx-auto px-4 md:px-6">
    <p class="text-2xl sm:text-3xl font-semibold sm:text-center text-primary mb-5 sm:mb-10">
      Frequently Asked Questions
    </p>

    <div class="bg-white rounded-xl px-2 py-5 sm:p-5">
      <h3 class="text-xl sm:text-2xl font-semibold text-gray-700">
        What is Remove PDF Pages?
      </h3>
      <p class="text-gray-600 mt-3 sm:text-lg leading-relaxed">
        It allows you to delete unwanted or blank pages from your PDF document while keeping the rest intact.
      </p>
    </div>

    <div class="border-t border-gray-200 mx-0 sm:mx-10"></div>

    <div class="bg-white rounded-xl px-2 py-5 sm:p-5">
      <h3 class="text-xl sm:text-2xl font-semibold text-gray-700">
        Can I remove multiple pages at once?
      </h3>
      <p class="text-gray-600 mt-3 sm:text-lg leading-relaxed">
        Yes. You can select and remove multiple pages in a single operation.
      </p>
    </div>
  </div>
</div>

<div class="border-t border-gray-200 mx-4 sm:mx-5"></div>

<p class="text-2xl sm:text-3xl font-semibold text-center text-gray-800 mt-10">
  Explore More Tools
</p>

<%- include("../toolsListIcons", { removeCards: ["/remove-pages"] }) %>

<%- include("../footer") %>

<script>
  const dropZone = document.getElementById('dropZone');

  dropZone.addEventListener('dragover', (event) => {
    event.preventDefault();
    dropZone.classList.add('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('dragenter', (event) => {
    event.preventDefault();
    dropZone.classList.add('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('dragleave', (event) => {
    event.preventDefault();
    dropZone.classList.remove('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('drop', (event) => {
    event.preventDefault();
    dropZone.classList.remove('bg-purple-100', 'border-solid', 'border-black-500');
    handleDrop(event);
  });

  dropZone.addEventListener('click', () => {
    document.getElementById('pdfInput').click();
  });

  function handleDrop(event) {
    const files = event.dataTransfer.files;
    if (files.length) {
      document.getElementById('pdfInput').files = files;
      handleFileSelect({ target: { files } });
    }
  }

  function handleFileSelect(event) {
    const files = event.target.files;
    // Add your file handling logic here
    console.log('Selected files:', files);
  }
</script>