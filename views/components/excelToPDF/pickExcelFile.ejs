<div class="flex justify-center">
  <div class="bg-white rounded-lg shadow-lg p-6 sm:p-10 m-4 sm:mb-0 max-w-2xl md:mx-auto text-center">
    <h1 class="text-2xl sm:text-3xl font-semibold text-[var(--primary-color)] mb-4">
      Convert EXCEL to PDF
    </h1>

    <h2 class="text-gray-600 sm:text-lg tracking-wide mb-4">
      Convert Excel spreadsheets (.xls, .xlsx) to high-quality PDF files instantly.
    </h2>

    <div id="dropZone"
      class="border-2 border-dashed border-primary p-8 sm:p-10 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors duration-200">
      <input type="file" id="excelInput"
            accept=".xls,.xlsx,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            multiple class="hidden" onchange="handleFileSelect(event)">
      <button
        class="bg-[var(--primary-color)] text-white sm:text-xl px-6 py-2 sm:py-3 rounded-lg hover:bg-purple-700 transition mb-4">
        Select Excel Files
