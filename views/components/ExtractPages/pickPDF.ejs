<div class="flex justify-center">
  <div class="bg-white rounded-lg shadow-lg p-6 sm:p-10 m-4 sm:mb-0 max-w-2xl md:mx-auto text-center">
    <h1 class="text-2xl sm:text-3xl font-semibold text-primary mb-4">Extract Images/Pages from PDF online</h1>

    <h2 class="text-gray-600 sm:text-lg tracking-wide mb-4">
      Extract PFD pages in images or PDF format with high quality.
    </h2>

    <div id="dropZone"
      class="border-2 border-dashed border-gray-400 hover:border-gray-500 p-8 sm:p-10 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors duration-200">
      <input type="file" id="pdfInput" accept="application/pdf" class="hidden" onchange="handleFileSelect(event)">
      <button
        class="bg-[var(--primary-color)] text-white sm:text-xl px-6 py-2 sm:py-3 rounded-lg hover:bg-secondary transition mb-4">
        Select PDF
      </button>
      <p class="text-gray-600 text-sm">Drag and drop PDF here or click to select</p>
    </div>
  </div>
</div>

<% const tool={ "tool-description" : { name: "Extract pages from PDF" ,
  desc: "Extract images/pages from PDF without quality loss." }, "tool-process" : { name: "Extract in any format" ,
  desc: "Can extract PDF pages in images or PDF format." }, "tool-setting" : { name: "Advance Settings" ,
  desc: "In advance setting select extract format of PDF pages." }, "download-info" : { name: "Single Click Conversion"
  , desc: "Extract pages from PDF in few steps and download or preview PDF." } }; %>

  <%- include("../toolOperations", {tool_info : tool}) %>

    <div id="tool-usage" class="py-10 md:py-10 bg-white mt-5 sm:mt-0">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <p class="text-2xl sm:text-3xl font-semibold text-center text-primary mb-5">
          How to use
          <span class="underline underline-offset-4">Extract Pages</span>
          Tool
        </p>

        <!-- Step 1 -->
        <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10 md:mb-20">
          <div class="lg:order-1">
            <%- include("../carousel", { images: ["/images/extractpdf-laptop-1.webp", "/images/extractpdf-tablet-1.webp"
              , "/images/extractpdf-mobile-1.webp" ] }) %>
          </div>
          <div class="space-y-6 lg:order-2">
            <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Drag & Drop or Select File</h3>
            <p class="text-gray-600 sm:text-lg tracking-wide">
              Select PDF file by clicking the button or drag & drop in order to Extract pages from it.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10 md:mb-20">
          <div class="space-y-6 order-2 lg:order-1">
            <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Select extraction format</h3>
            <p class="text-gray-600 sm:text-lg tracking-wide">
              After selecting the PDF file select the extraction format from setting panel (it can be image or PDF and
              default value is PDF) and hit Convert to PDF.
            </p>
          </div>
          <div class="order-1 lg:order-2">
            <%- include("../carousel", { images: ["/images/extractpdf-laptop-2.webp", "/images/extractpdf-tablet-2.webp"
              , "/images/extractpdf-mobile-2.webp" ] }) %>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10">
          <div class="lg:order-1">
            <%- include("../carousel", { images: ["/images/download-laptop.webp", "/images/download-tablet.webp"
              , "/images/download-mobile.webp" ] }) %>
          </div>
          <div class="space-y-6 lg:order-2">
            <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Download or Preview PDF</h3>
            <p class="text-gray-600 sm:text-lg tracking-wide">
              Wait a moment and you will be redirected on download page where you can download zip file for pages.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div id="faq-section" class="bg-white sm:mt-0 mb-10">
      <div class="max-w-5xl mx-auto px-4 md:px-6">
        <p class="text-2xl sm:text-3xl font-semibold sm:text-center text-primary mb-5 sm:mb-10">
          What People Frequently Ask
        </p>


        <div class="bg-white rounded-xl px-2 py-5 sm:p-5">
          <h3 class="text-xl sm:text-2xl font-semibold text-gray-700">
            How to extract PDF pages online free?
          </h3>
          <p class="text-gray-600  mt-3 sm:text-lg leading-relaxed">
            This tool is very easy with attractive interface. In order to extract pages from PDF just
            follow <a href="#tool-usage" class="text-blue-600 hover:text-blue-700 underline">few steps</a>.
          </p>
        </div>

        <div class="border-t border-gray-200 mx-0 sm:mx-10 my-3"></div>


        <div class="bg-white rounded-xl px-2 py-5 sm:p-5">
          <h3 class="text-xl sm:text-2xl font-semibold text-gray-700">
            Which extraction format this tool support?
          </h3>
          <p class="text-gray-600  mt-3 sm:text-lg leading-relaxed">
            Export PDF pages in image or PDF format.
          </p>
        </div>


        <div class="border-t border-gray-200 mx-0 sm:mx-10 my-3"></div>


        <div class="bg-white rounded-xl px-2 py-5 sm:p-5">
          <h3 class="text-xl sm:text-2xl font-semibold text-gray-700">
            What is the maximum PDF file size allowed?
          </h3>
          <p class="text-gray-600  mt-3 sm:text-lg leading-relaxed">
            We support maximum PDF file size up to 20 MB.
          </p>
        </div>



        <div class="border-t border-gray-200 mx-0 sm:mx-10 my-3"></div>


        <div class="bg-white rounded-xl px-2 py-5 sm:p-5">
          <h3 class="text-xl sm:text-2xl font-semibold text-gray-700">
            Maximum number of PDF files I can upload to extract pages at once?
          </h3>
          <p class="text-gray-600  mt-3 sm:text-lg leading-relaxed">
            we support only one PDF file to extract pages at once.
          </p>
        </div>





      </div>
    </div>

    <div class="border-t border-gray-200 mx-4 sm:mx-5"></div>

    <p class="text-2xl sm:text-3xl font-semibold text-center text-gray-800 mt-10">
      Explore More Tools
    </p>

    <%- include("../toolsListIcons", { removeCards: ["/extract-pdf-pages"] }) %>

      <%- include("../footer") %>

        <script>
          const dropZone = document.getElementById('dropZone');

          dropZone.addEventListener('dragover', (event) => {
            event.preventDefault();
            console.log("dragover")
            dropZone.classList.add('bg-gray-100');
          });

          dropZone.addEventListener('dragenter', (event) => {
            event.preventDefault();
            console.log("dragenter")
            dropZone.classList.remove('border-gray-400')
            dropZone.classList.add('bg-gray-100', 'border-primary');
          });

          dropZone.addEventListener('dragleave', (event) => {
            event.preventDefault();
            console.log("dragleave")
            dropZone.classList.remove('bg-gray-100', 'border-primary');
            dropZone.classList.add('border-gray-400')
          });

          dropZone.addEventListener('drop', (event) => {
            event.preventDefault();
            console.log("drop")
            dropZone.classList.remove('bg-gray-100', 'border-primary');
            dropZone.classList.add('border-gray-400')
            handleDrop(event);

          });

          dropZone.addEventListener('click', () => {
            document.getElementById('pdfInput').click();
          });

          function handleDrop(event) {
            const files = event.dataTransfer.files;

            if (files.length) {
              document.getElementById('pdfInput').files = files;
              handleFileSelect({ target: { files } });
            }
          }

          function handleFileSelect(event) {
            const files = event.target.files;

            // Add your file handling logic here
            console.log('Selected files:', files);
          }
        </script>