<style>
    .required::after {
        content: " *";
        color: #7100ad;
        font-weight: 600;
    }
</style>

<div class="font-sans bg-gray-50 text-gray-900">
    <div class="relative">

        <!-- Desktop Version -->
        <div class="hidden md:block max-w-3xl mx-auto p-4 pb-24">

            <!-- Password Protection Section -->
            <div class="settings-card bg-white rounded-2xl shadow-sm p-6">
                <div class="space-y-6">
                    <div>
                        <h2 class="text-xl font-semibold text-gray-900 mb-1">Protect PDF with Password</h2>
                        <p class="text-sm text-gray-600">Set a password to secure your PDF file.</p>
                    </div>

                    <div class="space-y-6">
                        <!-- Password -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5 required">Password</label>
                            <input type="password" id="protectPasswordDesktop" minlength="6"
                                class="w-full px-5 py-3.5 border border-gray-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900 placeholder-gray-400"
                                placeholder="Enter password">
                        </div>

                        <!-- Confirm Password -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5 required">Confirm
                                Password</label>
                            <input type="password" id="protectConfirmPasswordDesktop" minlength="6"
                                class="w-full px-5 py-3.5 border border-gray-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900 placeholder-gray-400"
                                placeholder="Confirm password">

                            <p id="passwordErrorDesktop" class="text-red-600 text-sm mt-2 hidden">
                                Passwords do not match
                            </p>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mobile Drawer -->
        <button id="settingsBtn"
            class="md:hidden fixed top-1/2 right-4 -translate-y-1/2 z-40 w-12 h-12 bg-white/80 backdrop-blur-md border border-purple-200 rounded-full flex items-center justify-center text-purple-700 shadow-lg hover:bg-purple-100/50 transition-all">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path
                    d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l-.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                <circle cx="12" cy="12" r="3" />
            </svg>
        </button>

        <div id="drawerOverlay" class="fixed inset-0 bg-black/50 z-50 opacity-0 invisible transition-all md:hidden">
        </div>

        <div id="drawer"
            class="fixed inset-y-0 right-0 w-[90vw] max-w-sm bg-white z-50 translate-x-full transition-transform duration-300 flex flex-col border-l border-purple-200 md:hidden">
            <div
                class="flex items-center justify-between p-4 border-b border-purple-100 bg-gradient-to-b from-purple-50 to-white sticky top-0 z-10">
                <h2 class="flex items-center gap-2 text-lg font-semibold text-purple-700">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                        <circle cx="9" cy="9" r="2" />
                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                    </svg>
                    Protect PDF
                </h2>
                <button id="drawerClose"
                    class="w-8 h-8 flex items-center justify-center text-purple-500 hover:bg-purple-100/50 rounded transition-all">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto p-6 space-y-6">

                <!-- Password Protection (Mobile) -->
                <div class="settings-card bg-white rounded-2xl shadow-sm p-6">
                    <div class="space-y-6">
                        <div>
                            <h2 class="text-xl font-semibold text-gray-900 mb-1">Protect with Password</h2>
                            <p class="text-sm text-gray-600">Set a password to secure your PDF file.</p>
                        </div>

                        <div class="space-y-6">
                            <!-- Password -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5 required">Password</label>
                                <input type="password" id="protectPasswordMobile" minlength="6"
                                    class="w-full px-5 py-3.5 border border-gray-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900 placeholder-gray-400"
                                    placeholder="Enter password">
                            </div>

                            <!-- Confirm Password -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5 required">Confirm Password</label>
                                <input type="password" id="protectConfirmPasswordMobile" minlength="6"
                                    class="w-full px-5 py-3.5 border border-gray-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900 placeholder-gray-400"
                                    placeholder="Confirm password">

                                <p id="passwordErrorMobile" class="text-red-600 text-sm mt-2 hidden">
                                    Passwords do not match
                                </p>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Convert Button -->
        <div
            class="fixed bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-white/95 to-transparent backdrop-blur-md z-30">
            <button id="convertBtn"
                class="max-w-md mx-auto flex items-center justify-center gap-2 w-full p-3 bg-primary text-white rounded-lg font-semibold shadow-lg hover:shadow-xl hover:bg-purple-600 transition-all">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7,10 12,15 17,10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                Protect PDF
            </button>
        </div>

    </div>
</div>