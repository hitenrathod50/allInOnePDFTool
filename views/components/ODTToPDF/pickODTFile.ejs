<script>
  const dropZone = document.getElementById('dropZone');
  const odtInput = document.getElementById('odtInput');

  dropZone.addEventListener('dragover', (event) => {
    event.preventDefault();
    dropZone.classList.add('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('dragenter', (event) => {
    event.preventDefault();
    dropZone.classList.add('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('dragleave', (event) => {
    event.preventDefault();
    dropZone.classList.remove('bg-purple-100', 'border-solid', 'border-black-500');
  });

  dropZone.addEventListener('drop', (event) => {
    event.preventDefault();
    dropZone.classList.remove('bg-purple-100', 'border-solid', 'border-black-500');
    handleDrop(event);
  });

  dropZone.addEventListener('click', () => {
    odtInput.click();
  });

  function handleDrop(event) {
    const files = event.dataTransfer.files;
    if (files.length) {
      odtInput.files = files;
      handleFileSelect({ target: { files } });
    }
  }

  function handleFileSelect(event) {
    const files = event.target.files;
    const allowedExtensions = ['odt'];
    const validFiles = [];

    for (const file of files) {
      const ext = file.name.split('.').pop().toLowerCase();
      if (allowedExtensions.includes(ext)) {
        validFiles.push(file);
      } else {
        alert(`Invalid file type: ${file.name}. Only .odt files are allowed.`);
      }
    }

    if (validFiles.length) {
      console.log('Selected ODT files:', validFiles);
      // Add your conversion logic here
    }
  }
</script>