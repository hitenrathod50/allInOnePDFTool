<div class="flex justify-center">
  <div class="bg-white rounded-lg shadow-lg p-6 sm:p-10 m-4 sm:mb-0 max-w-2xl md:mx-auto text-center">
    <h1 class="text-2xl sm:text-3xl font-semibold text-primary mb-4">Rotate PDF pages online</h1>

    <h2 class="text-gray-600 sm:text-lg tracking-wide mb-4">
      Rotate every pages of PDF online. Get rotated PDF file in few moment with preview.
    </h2>

    <div id="dropZone" class="border-2 border-dashed border-gray-400 hover:border-gray-500 p-8 sm:p-10 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors duration-200">
      <input type="file" id="pdfInputFirst" accept="application/pdf" class="hidden"
        onchange="handleFileSelect(event)">
      <button
        class="bg-[var(--primary-color)] text-white sm:text-xl px-6 py-2 sm:py-3 rounded-lg hover:bg-secondary transition mb-4">
        Select PDF
      </button>
      <p class="text-gray-600 text-sm">Drag and drop PDF here or click to select</p>
    </div>

    <%- include('../secure.ejs') %>

  </div>
</div>

<% const tool = {
  "tool-description": {
    name: "Rotate PDF pages online",
    desc: "Select/drop PDF file you want to rotate. No compression, no sign up required."
  },
  "tool-process": {
    name: "Select Page Rotation",
    desc: "Select the page turn degree you want out of 90, 180 and 270."
  },
  "tool-setting": {
    name: "Advance Settings",
    desc: "In advance settings you can set the margin to the pages."
  },
  "download-info": {
    name: "Rotate PDF in few moment",
    desc: "Get rotated PDF file in few moment and download or preview it."
  }
}; %>

<%- include("../toolOperations", {tool_info : tool}) %>

<div id="tool-usage" class="py-10 md:py-10 bg-white mt-5 sm:mt-0">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <p class="text-2xl sm:text-3xl font-semibold text-center text-primary mb-5">
          How to use
          <span class="underline underline-offset-4">Rotate PDF Pages</span>
          Tool
        </p>

    <!-- Step 1 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10 md:mb-20">
      <div class="lg:order-1">
        <%- include("../carousel", { images: ["/images/rotatepdf-laptop-1.webp", "/images/rotatepdf-tablet-1.webp", "/images/rotatepdf-mobile-1.webp"] }) %>
      </div>
      <div class="space-y-6 lg:order-2">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Drag & Drop or Select File</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Select PDF file by clicking the button or drag & drop in order to rotate every page of that PDF.
        </p>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10 md:mb-20">
      <div class="space-y-6 order-2 lg:order-1">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Select page rotation angle</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Select the rotation angle you want out of 90°, 180° and 270° (with preview). Also you can set margin to the each page of that PDF. After setting up everything click on Conver to PDF.
        </p>
      </div>
      <div class="order-1 lg:order-2">
        <%- include("../carousel", { images: ["/images/rotatepdf-laptop-2.webp", "/images/rotatepdf-tablet-2.webp", "/images/rotatepdf-mobile-2.webp"] }) %>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center mb-10">
      <div class="lg:order-1">
        <%- include("../carousel", { images: ["/images/download-laptop.webp", "/images/download-tablet.webp"
              , "/images/download-mobile.webp" ] }) %>
      </div>
      <div class="space-y-6 lg:order-2">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-700">Download Rotated PDF</h3>
        <p class="text-gray-600 sm:text-lg tracking-wide">
          Wait a moment until you'll have download rotated PDF page where you can download or preview the rotated PDF.
        </p>
      </div>
    </div>
  </div>
</div>

 <div id="faq-section" class="bg-white sm:mt-0 mb-10">
