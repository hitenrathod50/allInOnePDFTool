<div class="flex justify-center">
  <div class="bg-white rounded-lg shadow-lg p-6 sm:p-10 m-4 sm:mb-0 max-w-2xl md:mx-auto text-center">
    <h1 class="text-2xl sm:text-3xl font-semibold text-[var(--primary-color)] mb-4">Edit PDF Pages</h1>

    <h2 class="text-gray-600 sm:text-lg tracking-wide mb-4">
      Add shapes, annotations, and edit PDF pages easily with our powerful editor.
    </h2>

    <div id="dropZone"
      class="border-2 border-dashed border-primary p-8 sm:p-10 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors duration-200">
      <input type="file" id="pdfInputFirst" accept="application/pdf" class="hidden"
        onchange="handleFileSelect(event)">
      <button
        class="bg-[var(--primary-color)] text-white sm:text-xl px-6 py-2 sm:py-3 rounded-lg hover:bg-purple-700 transition mb-4">
        Select PDF
      </button>
      <p class="text-gray-600 text-sm">Drag and drop PDF here or click to select</p>
    </div>
  </div>
</div>

<% const tool = {
  "tool-description": {
    name: "Drop/Select PDF File",
    desc: "select/drop PDF file to edit its pages."
  },
  "tool-process": {
    name: "Drop Shapes on Page",
    desc: "select any shape from shapes and put it on the page."
  },
  "tool-setting": {
    name: "Advance Settings",
    desc: "change shape properties like color, opacity, size, etc."
  },
  "download-info": {
    name: "Single Click Conversion",
    desc: "edit and save PDF in single click with fast processing."
  }
